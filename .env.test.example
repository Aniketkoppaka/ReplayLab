# ==============================================================================
# ReplayLab Test Environment Variables (Example Template)
# Used during automated testing and CI execution.
# ==============================================================================

NODE_ENV=test
PORT=4001
API_PORT=4001
FRONTEND_URL=http://localhost:3000

# Deterministic Demo Target API for Replay Testing
DEMO_TARGET_API_URL=http://localhost:8080

# Test Database Connection (Local ephemeral container or test database)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/replaylab_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/replaylab_test?schema=public"

# Tight test timeouts
REPLAY_MAX_TIMEOUT_MS=5000
REPLAY_MAX_RESPONSE_BYTES=1048576

# Test Auth Secret
AUTH_SECRET="test-secret-value-never-used-in-production-environments-32char"
