# ==============================================================================
# ReplayLab Environment Variables (Example Template)
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# --- Node Environment ---
NODE_ENV=development
PORT=3001

# --- Frontend Application (apps/web) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_ENABLE_DEV_AUTH=true

# --- Backend Application (apps/api) ---
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Database & Supabase (packages/db) ---
# Direct connection string for Prisma migrations
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/replaylab?schema=public"
# Direct connection for pooled runtime queries (if using Supabase connection pooler)
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/replaylab?schema=public"

# --- Replay Engine Constraints (apps/api) ---
# Maximum total timeout per replayed request (ms)
REPLAY_MAX_TIMEOUT_MS=15000
# Maximum response body buffer size in bytes (10MB default)
REPLAY_MAX_RESPONSE_BYTES=10485760
# Comma-separated list of additional disallowed CIDRs (if extending default SSRF blocklist)
REPLAY_EXTRA_BLOCKED_CIDRS=""

# --- Authentication & Session (apps/api) ---
# Symmetric JWT Secret (for offline/test environments) OR JWKS URI (for live Supabase auth)
SUPABASE_JWT_SECRET="insecure-development-secret-minimum-32-chars-long"
# SUPABASE_JWKS_URI="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_JWT_ISSUER="https://your-project.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# --- Application Secret Encryption (apps/api) ---
# 256-bit AES-GCM master key (hex-encoded 64 characters or 32 bytes)
# Used to encrypt sensitive environment variables at rest in PostgreSQL
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
